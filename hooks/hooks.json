    "PostToolUse": [{"matcher": "", "hooks": [{"type": "command", "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\scripts\\hook_usage_context.ps1\" -EventName PostToolUse", "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\scripts\\hook_usage_context.ps1\" -EventName PostToolUse", "timeout": 5}]}]
